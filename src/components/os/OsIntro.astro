---
/** 课程通识内容：简介、核心模块、先修后续、教材与实验（非国标数据，为常见教学体系整理） */
import { osRel } from '../courses/relations';

const { prereq, parallel, follow } = osRel;

const modules: { icon: string; title: string; desc: string; topics: string[] }[] = [
	{
		icon: '⚙️',
		title: '进程与线程',
		desc: '操作系统最核心的抽象。程序如何在 CPU 上“活”起来，多个程序如何共存并发。',
		topics: ['进程状态与 PCB', '线程与多线程模型', '进程间通信 IPC', '上下文切换'],
	},
	{
		icon: '📅',
		title: '处理机调度',
		desc: '有限的 CPU 时间如何分配给众多进程，决定系统吞吐与响应速度。',
		topics: ['FCFS / SJF / 时间片轮转', '优先级与多级反馈队列', '实时调度', '调度评价指标'],
	},
	{
		icon: '🔒',
		title: '同步与死锁',
		desc: '并发带来的正确性难题：如何互斥访问共享资源，如何避免永久僵持。',
		topics: ['信号量与管程', '生产者-消费者 / 哲学家就餐', '死锁四个必要条件', '银行家算法'],
	},
	{
		icon: '🧩',
		title: '内存管理',
		desc: '物理内存如何被安全高效地划分、映射与共享。',
		topics: ['分页与分段', '段页式管理', '空闲空间管理', '伙伴系统与 slab'],
	},
	{
		icon: '⚡',
		title: '虚拟内存',
		desc: '让程序以为自己独占巨大内存——计算机史上最优雅的抽象之一。',
		topics: ['局部性原理与请求分页', '页面置换 FIFO / LRU / Clock', '工作集与颠簸', '写时复制'],
	},
	{
		icon: '📁',
		title: '文件系统',
		desc: '数据的持久化组织：从文件名到磁盘块的全部映射链条。',
		topics: ['inode 与目录结构', '连续 / 链接 / 索引分配', '日志式文件系统', '虚拟文件系统 VFS'],
	},
	{
		icon: '💾',
		title: '设备管理与 I/O',
		desc: 'CPU 与速度悬殊的外设如何协同：慢，但不能拖垮系统。',
		topics: ['轮询 / 中断 / DMA', '缓冲与 SPOOLing', '磁盘调度 SSTF / SCAN', '即插即用'],
	},
	{
		icon: '🛡️',
		title: '安全与虚拟化',
		desc: '内核态与用户态的边界、访问控制，以及现代云时代的虚拟机与容器。',
		topics: ['保护机制与访问控制', '系统调用', '虚拟机与容器', 'Linux / Windows / 鸿蒙'],
	},
];

const books = [
	{ name: '《操作系统概念》', meta: 'Silberschatz 等 · “恐龙书”', note: '全球使用最广的教材，体系完整' },
	{ name: '《现代操作系统》', meta: 'Tanenbaum', note: 'MINIX 作者执笔，原理阐述深入' },
	{ name: '《操作系统导论》（OSTEP）', meta: 'Arpaci-Dusseau 夫妇', note: '免费在线，循序渐进，口碑极佳' },
	{ name: '《计算机操作系统》', meta: '汤小丹 等 · 西电出版社', note: '国内经典，考研主流教材' },
];
const labs = [
	{ name: 'MIT 6.S081 · XV6', note: '在小型 Unix 上动手实现系统调用、页表、文件系统' },
	{ name: 'NachOS / OS161', note: '教学用模拟内核，国内高校实验课常用' },
	{ name: 'Linux 内核实验', note: '内核模块、进程调度器观察与 eBPF 等实战入口' },
];
---

<section class="crs-block" id="intro">
	<header class="crs-block-head">
		<h2>这门课讲什么</h2>
		<p>
			操作系统（Operating Systems）是管理计算机软硬件资源、为应用程序提供运行环境的系统软件。
			这门课从「程序如何在机器上运行」这一根本问题出发，把 CPU、内存、外设的管理策略逐层展开——
			它是理解一切软件栈底座的钥匙，也是计算机类专业区分于培训班式编程训练的分水岭课程。
		</p>
	</header>

	<div class="crs-modules">
		{modules.map((m) => (
			<article class="crs-module">
				<h3><span class="crs-mi" aria-hidden="true">{m.icon}</span>{m.title}</h3>
				<p>{m.desc}</p>
				<ul>
					{m.topics.map((t) => <li>{t}</li>)}
				</ul>
			</article>
		))}
	</div>
</section>

<section class="crs-block" id="path">
	<header class="crs-block-head">
		<h2>先修与后续</h2>
		<p>操作系统处于课程体系的枢纽位置：向下衔接硬件，向上支撑所有系统级课程。</p>
	</header>
	<div class="crs-flow">
		<div class="crs-flow-col pre">
			<h4>先修课程</h4>
			{prereq.map((c) => <span class="crs-course">{c}</span>)}
		</div>
		<div class="crs-flow-mid">
			<span class="crs-arrow" aria-hidden="true">→</span>
			<span class="crs-core">操作系统</span>
			<span class="crs-arrow" aria-hidden="true">→</span>
		</div>
		<div class="crs-flow-col">
			<h4>并行课程</h4>
			{parallel.map((c) => <span class="crs-course">{c}</span>)}
		</div>
		<div class="crs-flow-col post">
			<h4>后续课程</h4>
			{follow.map((c) => <span class="crs-course">{c}</span>)}
		</div>
	</div>
</section>

<section class="crs-block" id="books">
	<header class="crs-block-head">
		<h2>经典教材与动手实验</h2>
		<p>“纸上得来终觉浅”——操作系统尤其如此，配一个实验内核学习效果翻倍。</p>
	</header>
	<div class="crs-books">
		{books.map((b) => (
			<article class="crs-book">
				<h3>{b.name}</h3>
				<p class="crs-book-meta">{b.meta}</p>
				<p>{b.note}</p>
			</article>
		))}
	</div>
	<ul class="crs-labs">
		{labs.map((l) => (
			<li><b>{l.name}</b><span>{l.note}</span></li>
		))}
	</ul>
</section>

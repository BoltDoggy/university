---
import { BASE } from '../../utils/base';
import Layout from '../../layouts/Layout.astro';
import AiSeries from '../../components/courses/AiSeries.astro';
import DataAnchor from '../../components/courses/DataAnchor.astro';
import CourseContent from '../../components/courses/CourseContent.astro';
import { practice } from '../../components/practice/content';
import '../../styles/course-base.css';
import '../../styles/course-content.css';
import '../../styles/course-series.css';
---

<Layout title="AI 产品实践 · 课程介绍">
	<div class="crs-page">
		<header class="hero">
			<p class="kicker">人工智能课程生态 · 进阶系列 · <a href={BASE + 'courses/ai/'}>人工智能</a></p>
			<h1>AI 产品实践<span class="en">AI Product Practicum</span></h1>
			<p class="sub">
				从 0 到 1 的综合实践课：组队选定真实需求，完成调研、设计、开发、评测、发布与路演的完整闭环——
				AI 课程体系的「毕业设计前哨」，所有先修能力在这里汇聚成一个可用的产品。
			</p>
			<nav class="toc" aria-label="页面导航">
				<a href="#anchor">数据锚点</a>
				<a href="#intro">内容模块</a>
				<a href="#path">先修与后续</a>
				<a href="#books">教材与实验</a>
			</nav>
			<AiSeries current="AI 产品实践" />
		</header>

		<DataAnchor note="AI 产品实践未出现在国标核心课程示例中，但国标确有其实践「容器」——附录「主要实践性教学环节」规定了实验课程、课程设计、实习、毕业设计（论文）及科技创新、社会实践等形态，并要求「至少完成 2 个有一定规模的系统的设计与开发」。AI 产品实践正是这一框架在大模型时代长出的新形态。" />
		<CourseContent {...practice} />

		<footer class="foot">
			本页数据锚点来自《普通高等学校本科专业类教学质量国家标准》（2018）附录与《普通高等学校本科专业目录（2026 年）》；
			内容模块、先修后续与教材部分为常见教学体系整理，不来自国标。各高校实际课程设置以本校培养方案为准。
		</footer>
	</div>
</Layout>

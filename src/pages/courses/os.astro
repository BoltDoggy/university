---
import { BASE } from '../../utils/base';
import Layout from '../../layouts/Layout.astro';
import OsStandard from '../../components/os/OsStandard.astro';
import OsIntro from '../../components/os/OsIntro.astro';
import '../../styles/course-base.css';
import '../../styles/course-content.css';
---

<Layout title="操作系统 · 课程介绍">
	<div class="crs-page">
		<header class="hero">
			<p class="kicker">计算机类（0809）· 学科基础核心知识领域 · <a href={BASE + 'core-courses/'}>核心课程可视化</a></p>
			<h1>操作系统<span class="en">Operating Systems</span></h1>
			<p class="sub">
				在国标核心课程示例中覆盖计算机类全部 5 个专业的每一份方案——是并列六大知识领域里当之无愧的「共同地基」。
				本页从国标数据出发，介绍它的体系定位、内容模块、修读路径与经典教材。
			</p>
			<nav class="toc" aria-label="页面导航">
				<a href="#standard">国标定位</a>
				<a href="#intro">内容模块</a>
				<a href="#path">先修与后续</a>
				<a href="#books">教材与实验</a>
			</nav>
		</header>

		<OsStandard />
		<OsIntro />

		<footer class="foot">
			国标数据来源：《普通高等学校本科专业类教学质量国家标准》（高等教育出版社 2018）附录，经扫描版 OCR 提取（书页 321-329）；
			内容模块、先修后续与教材部分为常见教学体系整理，不来自国标。各高校实际课程设置以本校培养方案为准。
		</footer>
	</div>
</Layout>

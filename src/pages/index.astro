---
import Layout from '../layouts/Layout.astro';
import majors from '../data/majors-2026.json';
import { DATA as industry } from '../data/industry.js';
import occupations from '../data/occupations-2022.json';

const { meta } = industry;

interface DatasetCard {
	href: string;
	accent: string;
	source: string;
	badge: string;
	title: string;
	desc: string;
	stats: [number, string][];
	go: string;
}

const datasets: DatasetCard[] = [
	{
		href: '/majors',
		accent: '#4f46e5',
		source: `${majors.publisher} · ${majors.publish_date}发布`,
		badge: String(majors.year),
		title: majors.title,
		desc: '学科门类—专业类—专业三级结构，支持按名称与代码检索；特设专业（T）与国家控制布点专业（K）逐项标注。',
		stats: [
			[majors.stats.categories, '学科门类'],
			[majors.stats.classes, '专业类'],
			[majors.stats.majors, '专业'],
		],
		go: '浏览目录',
	},
	{
		href: '/industry',
		accent: '#0284c7',
		source: `${meta.standard} · ${meta.effective} 实施`,
		badge: meta.standard.split('—')[1],
		title: meta.title,
		desc: '门类—大类—中类—小类四级分类，含各类目说明，支持按名称与代码检索，附 2011 版与国际标准（ISIC）对照。',
		stats: [
			[meta.counts.men, '门类'],
			[meta.counts.da, '大类'],
			[meta.counts.zhong, '中类'],
			[meta.counts.xiao, '小类'],
		],
		go: '浏览分类',
	},
	{
		href: '/occupations',
		accent: '#b45309',
		source: `人力资源和社会保障部 · ${occupations.edition}`,
		badge: occupations.edition.replace('年版', ''),
		title: occupations.title,
		desc: '大类—中类—小类—职业（细类）四级结构，支持按名称与代码检索；绿色职业（L）与数字职业（S）逐项标注。',
		stats: [
			[occupations.stats.categories, '大类'],
			[occupations.stats.middles, '中类'],
			[occupations.stats.minors, '小类'],
			[occupations.stats.occupations, '职业'],
		],
		go: '浏览大典',
	},
];
---

<Layout>
	<main class="hub">
		<div class="glow g1"></div>
		<div class="glow g2"></div>
		<header class="head">
			<p class="pill"><i></i>{datasets.length} 个数据集已上线 · 持续扩充</p>
			<h1>国家参考数据可视化</h1>
			<p class="sub">常用国家标准与目录的可视化浏览与检索工具</p>
		</header>
		<div class="grid">
			{
				datasets.map((d) => (
					<a class="card" href={d.href} style={`--accent: ${d.accent}`}>
						<p class="source">
							<span class="icon">
								<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
									<path d="M12 3 3 7.5 12 12l9-4.5L12 3Z" />
									<path d="m3 12 9 4.5L21 12" />
									<path d="m3 16.5 9 4.5 9-4.5" />
								</svg>
							</span>
							{d.source}
						</p>
						<h2>
							{d.title}
							<span class="badge">{d.badge}</span>
						</h2>
						<p class="desc">{d.desc}</p>
						<p class="stats">
							{d.stats.map(([num, unit]) => (
								<span class="stat">
									<b>{num}</b>
									{unit}
								</span>
							))}
						</p>
						<span class="go">
							{d.go}
							<svg class="arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
								<path d="M5 12h14M13 6l6 6-6 6" />
							</svg>
						</span>
					</a>
				))
			}
			<div class="card ghost">
				<span class="plus">
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
						<path d="M12 5v14M5 12h14" />
					</svg>
				</span>
				<p class="ghost-title">更多数据集筹备中</p>
				<p class="ghost-sub">职业教育专业目录 · 研究生学科目录 · ……</p>
			</div>
		</div>
	</main>
</Layout>

<style>
	.hub {
		position: relative;
		min-height: 100vh;
		box-sizing: border-box;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 40px;
		padding: 56px 24px;
		overflow: hidden;
	}
	.glow {
		position: absolute;
		border-radius: 50%;
		filter: blur(80px);
		pointer-events: none;
	}
	.glow.g1 {
		width: 420px;
		height: 420px;
		background: #c7d2fe;
		top: -140px;
		right: -100px;
		opacity: 0.55;
	}
	.glow.g2 {
		width: 360px;
		height: 360px;
		background: #bae6fd;
		bottom: -160px;
		left: -120px;
		opacity: 0.5;
	}
	.head {
		position: relative;
		text-align: center;
	}
	.pill {
		display: inline-flex;
		align-items: center;
		gap: 7px;
		margin: 0 0 18px;
		font-size: 13px;
		color: #4b5563;
		background: #fff;
		border: 1px solid #e5e7eb;
		border-radius: 999px;
		padding: 5px 14px;
		box-shadow: 0 1px 2px rgba(28, 32, 36, 0.04);
	}
	.pill i {
		width: 7px;
		height: 7px;
		border-radius: 50%;
		background: #10b981;
		box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.15);
	}
	h1 {
		margin: 0;
		font-size: clamp(30px, 5vw, 42px);
		letter-spacing: 0.02em;
	}
	.sub {
		margin: 12px 0 0;
		color: #4b5563;
		line-height: 1.8;
	}
	.grid {
		position: relative;
		width: 100%;
		max-width: 1120px;
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
		gap: 20px;
	}
	.card {
		--accent: #4f46e5;
		display: flex;
		flex-direction: column;
		gap: 12px;
		box-sizing: border-box;
		background: #fff;
		border: 1px solid #e5e7eb;
		border-radius: 18px;
		padding: 26px;
		color: inherit;
		text-decoration: none;
		transition:
			transform 0.18s,
			box-shadow 0.18s,
			border-color 0.18s;
	}
	.card:hover {
		transform: translateY(-4px);
		border-color: color-mix(in srgb, var(--accent) 45%, #e5e7eb);
		box-shadow: 0 14px 32px rgba(28, 32, 36, 0.09);
	}
	.source {
		display: flex;
		align-items: center;
		gap: 8px;
		margin: 0;
		font-size: 12.5px;
		color: #6b7280;
	}
	.icon {
		display: inline-flex;
		width: 26px;
		height: 26px;
		align-items: center;
		justify-content: center;
		border-radius: 8px;
		color: var(--accent);
		background: color-mix(in srgb, var(--accent) 10%, #fff);
		flex: none;
	}
	.icon svg {
		width: 15px;
		height: 15px;
	}
	h2 {
		margin: 0;
		font-size: 19px;
		line-height: 1.45;
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 8px;
	}
	.badge {
		font-size: 11.5px;
		font-weight: 600;
		color: var(--accent);
		background: color-mix(in srgb, var(--accent) 9%, #fff);
		border-radius: 6px;
		padding: 2px 7px;
	}
	.desc {
		margin: 0;
		flex: 1;
		color: #4b5563;
		font-size: 13.5px;
		line-height: 1.85;
	}
	.stats {
		display: flex;
		flex-wrap: wrap;
		gap: 6px 16px;
		margin: 0;
		padding-top: 14px;
		border-top: 1px solid #f0f1f4;
		font-size: 12px;
		color: #6b7280;
	}
	.stat b {
		font-size: 16px;
		font-weight: 650;
		color: #1c2024;
		margin-right: 4px;
		font-variant-numeric: tabular-nums;
	}
	.go {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		font-size: 14px;
		font-weight: 600;
		color: var(--accent);
	}
	.arrow {
		width: 15px;
		height: 15px;
		transition: transform 0.18s;
	}
	.card:hover .arrow {
		transform: translateX(4px);
	}
	.ghost {
		align-items: center;
		justify-content: center;
		text-align: center;
		border-style: dashed;
		border-color: #d8dbe2;
		background: rgba(255, 255, 255, 0.45);
		color: #9ca3af;
	}
	.plus {
		display: inline-flex;
		width: 34px;
		height: 34px;
		align-items: center;
		justify-content: center;
		border-radius: 50%;
		border: 1.5px dashed #c9cdd6;
	}
	.plus svg {
		width: 16px;
		height: 16px;
	}
	.ghost-title {
		margin: 2px 0 0;
		font-size: 14px;
		font-weight: 600;
		color: #6b7280;
	}
	.ghost-sub {
		margin: 0;
		font-size: 12.5px;
		line-height: 1.7;
	}
</style>

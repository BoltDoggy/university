---
import { BASE } from '../utils/base';
import Layout from '../layouts/Layout.astro';
import majors from '../data/majors-2026.json';
import { DATA as industry } from '../data/industry.js';
import occupations from '../data/occupations-2022.json';
import '../styles/home.css';
import coreCourses from '../data/core-courses.json';

const { meta } = industry;

const cc = coreCourses.classes;
const ccMajors = cc.reduce((s: number, c: { majors: unknown[] }) => s + c.majors.length, 0);
const ccExamples = cc.reduce(
	(s: number, c: { majors: { ex: unknown[] }[] }) => s + c.majors.reduce((t: number, m) => t + m.ex.length, 0),
	0,
);

interface DatasetCard {
	href: string;
	accent: string;
	source: string;
	badge: string;
	title: string;
	desc: string;
	stats: [number, string][];
	go: string;
}

const datasets: DatasetCard[] = [
	{
		href: BASE + 'majors',
		accent: '#4f46e5',
		source: `${majors.publisher} · ${majors.publish_date}发布`,
		badge: String(majors.year),
		title: majors.title,
		desc: '学科门类—专业类—专业三级结构，支持按名称与代码检索；特设专业（T）与国家控制布点专业（K）逐项标注。',
		stats: [
			[majors.stats.categories, '学科门类'],
			[majors.stats.classes, '专业类'],
			[majors.stats.majors, '专业'],
		],
		go: '浏览目录',
	},
	{
		href: BASE + 'industry',
		accent: '#0284c7',
		source: `${meta.standard} · ${meta.effective} 实施`,
		badge: meta.standard.split('—')[1],
		title: meta.title,
		desc: '门类—大类—中类—小类四级分类，含各类目说明，支持按名称与代码检索，附 2011 版与国际标准（ISIC）对照。',
		stats: [
			[meta.counts.men, '门类'],
			[meta.counts.da, '大类'],
			[meta.counts.zhong, '中类'],
			[meta.counts.xiao, '小类'],
		],
		go: '浏览分类',
	},
	{
		href: BASE + 'core-courses',
		accent: '#0e7490',
		source: '教育部教学指导委员会 · 高等教育出版社 2018',
		badge: '国标',
		title: '本科专业类核心课程',
		desc: '电子信息类与计算机类的核心课程体系示例：课程公共度排行、专业 × 课程矩阵，找出覆盖全部专业的公共核心课。',
		stats: [
			[cc.length, '专业类'],
			[ccMajors, '专业'],
			[ccExamples, '课程示例'],
		],
		go: '查看课程',
	},
	{
		href: BASE + 'occupations',
		accent: '#b45309',
		source: `人力资源和社会保障部 · ${occupations.edition}`,
		badge: occupations.edition.replace('年版', ''),
		title: occupations.title,
		desc: '大类—中类—小类—职业（细类）四级结构，支持按名称与代码检索；绿色职业（L）与数字职业（S）逐项标注。',
		stats: [
			[occupations.stats.categories, '大类'],
			[occupations.stats.middles, '中类'],
			[occupations.stats.minors, '小类'],
			[occupations.stats.occupations, '职业'],
		],
		go: '浏览大典',
	},
];

/** 课程解读页入口（临时：未全部接入 /core-courses 深链的课程在此统一露出） */
const courseEntries: { name: string; href: string; tag: string }[] = [
	{ name: '操作系统', href: BASE + 'courses/os/', tag: '国标' },
	{ name: '人工智能', href: BASE + 'courses/ai/', tag: '国标' },
	{ name: '机器学习导论', href: BASE + 'courses/ml/', tag: 'AI 系列' },
	{ name: '深度学习', href: BASE + 'courses/dl/', tag: 'AI 系列' },
	{ name: '强化学习', href: BASE + 'courses/rl/', tag: 'AI 系列' },
	{ name: '自然语言处理', href: BASE + 'courses/nlp/', tag: 'AI 系列' },
	{ name: '对话系统', href: BASE + 'courses/dialog/', tag: 'AI 系列' },
	{ name: '大模型技术', href: BASE + 'courses/llm/', tag: 'AI 系列' },
	{ name: '大模型与智能体', href: BASE + 'courses/agent/', tag: 'AI 系列' },
	{ name: 'AI 应用工程', href: BASE + 'courses/app-eng/', tag: 'AI 系列' },
	{ name: 'AI 产品工程', href: BASE + 'courses/prod-eng/', tag: 'AI 系列' },
	{ name: 'AI 产品实践', href: BASE + 'courses/practice/', tag: 'AI 系列' },
	{ name: '自动决策系统', href: BASE + 'courses/decision/', tag: 'AI 系列' },
	{ name: '课程图谱', href: BASE + 'courses/map/', tag: '总览' },
];
---

<Layout>
	<main class="hub">
		<div class="glow g1"></div>
		<div class="glow g2"></div>
		<header class="head">
			<p class="pill"><i></i>{datasets.length} 个数据集已上线 · 持续扩充</p>
			<h1>国家参考数据可视化</h1>
			<p class="sub">常用国家标准与目录的可视化浏览与检索工具</p>
		</header>
		<div class="grid">
			{
				datasets.map((d) => (
					<a class="card" href={d.href} style={`--accent: ${d.accent}`}>
						<p class="source">
							<span class="icon">
								<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
									<path d="M12 3 3 7.5 12 12l9-4.5L12 3Z" />
									<path d="m3 12 9 4.5L21 12" />
									<path d="m3 16.5 9 4.5 9-4.5" />
								</svg>
							</span>
							{d.source}
						</p>
						<h2>
							{d.title}
							<span class="badge">{d.badge}</span>
						</h2>
						<p class="desc">{d.desc}</p>
						<p class="stats">
							{d.stats.map(([num, unit]) => (
								<span class="stat">
									<b>{num}</b>
									{unit}
								</span>
							))}
						</p>
						<span class="go">
							{d.go}
							<svg class="arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
								<path d="M5 12h14M13 6l6 6-6 6" />
							</svg>
						</span>
					</a>
				))
			}
			<div class="card ghost">
				<span class="plus">
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
						<path d="M12 5v14M5 12h14" />
					</svg>
				</span>
				<p class="ghost-title">更多数据集筹备中</p>
				<p class="ghost-sub">职业教育专业目录 · 研究生学科目录 · ……</p>
			</div>
		</div>

		<div class="course-strip">
			<span class="strip-label">课程解读</span>
			<div class="strip-links">
				{
					courseEntries.map((c) => (
						<a class="strip-link" href={c.href}>
							<i class={c.tag === '国标' ? 'dot guobiao' : 'dot ai'} />
							{c.name}
							<em>{c.tag}</em>
						</a>
					))
				}
			</div>
			<span class="strip-note">基于《教学质量国家标准》数据延伸 · 持续补充</span>
		</div>
	</main>
</Layout>
